# CodeAtlas configuration. Copy to `.env` (gitignored) and fill in what you need.
# Every setting the backend reads is listed here; empty values fall back to the default.

# --- Storage ---
# Root for clones, code graphs and the SQLite DB (default: ./data at the repo root)
DATA_DIR=
# Override the SQLite file location (default: <DATA_DIR>/codeatlas.db)
SQLITE_PATH=

# --- Ingestion limits ---
MAX_REPO_SIZE_MB=300
MAX_PYTHON_FILES=6000
MAX_FILE_SIZE_BYTES=1000000
# Ignore list adjustments (JSON list or comma-separated). Built-in defaults skip .git, venvs,
# node_modules, site-packages, build/dist, vendor dirs, lock files, *.min.js, *_pb2.py, ...
EXTRA_IGNORE_DIRS=
EXTRA_IGNORE_GLOBS=
# Default-ignored directory names to index anyway, e.g. UNIGNORE_DIRS=vendor,build
UNIGNORE_DIRS=

# --- Vector DB / embeddings ---
# Use ":memory:" for an in-process Qdrant (tests only)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# fastembed (local, default) | openai (dense only; BM25 stays local)
DENSE_EMBEDDING_PROVIDER=fastembed
DENSE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
# Where downloaded embedding/reranker models are cached (default: <DATA_DIR>/models)
MODELS_CACHE_DIR=
# Chunking strategies to index: ast (main system) and fixed (naive baseline / ablation)
INDEX_STRATEGIES=["ast", "fixed"]

# --- LLM providers: anthropic | openai | ollama ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Anthropic output_config.effort: low | medium | high | xhigh | max
LLM_EFFORT=medium
# OpenAI/Ollama only: the Anthropic Messages API rejects sampling parameters
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120
# LLM-as-judge for the eval harness (kept separate from the system model)
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Agent budgets ---
AGENT_MAX_TOOL_CALLS=10
# Total tokens processed per answer (input + output + cache), summed over all LLM calls
AGENT_MAX_TOKENS=250000
TOOL_OUTPUT_MAX_CHARS=12000

# --- GitHub / history (token optional; without it the API rate limit is 60 req/h) ---
GITHUB_TOKEN=
HISTORY_PRELINK_COMMITS=500

# --- API / service ---
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]
# If set, POST /repos requires `Authorization: Bearer <ADMIN_TOKEN>`
ADMIN_TOKEN=
# Secret configured on the GitHub webhook (verifies X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=
# Per-IP limits (in-process; see README for multi-worker deployments)
RATE_LIMIT_REPOS_PER_MINUTE=5
RATE_LIMIT_ASK_PER_MINUTE=20
MAX_REQUEST_BYTES=64000
MAX_WEBHOOK_BYTES=5000000
MAX_CONCURRENT_INDEX_JOBS=2

# --- Observability (optional; tracing is disabled unless both keys are set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
